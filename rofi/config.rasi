/**
 * ~/.config/rofi/config.rasi
 * Launch everything:  rofi -show combi
 * Switch modes while open: Shift+Left / Shift+Right
 */
configuration {
    /* what rofi can show (first one is the default for plain `rofi`) */
    modes:                "combi,drun,run,window,filebrowser";
    combi-modes:          "drun,run";
    combi-display-format: "<span alpha='55%' size='small'>{mode}</span>  {text}";
    display-combi:        "All";

    /* look and feel */
    font:                 "JetBrains Mono Nerd Font";
    show-icons:           true;
    /* icon-theme:        "Papirus"; */   /* uncomment if you have an icon theme installed */
    display-drun:         "Apps";
    display-run:          "Run";
    display-window:       "Windows";
    display-filebrowser:  "Files";
    drun-display-format:  "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
    window-format:        "{w}  {c}  {t}";

    /* searching */
    matching:             "fuzzy";
    sorting-method:       "fzf";
    case-smart:           true;
    drun-match-fields:    "name,generic,exec,categories,keywords";

    /* behaviour */
    terminal:             "kitty";
    run-shell-command:    "{terminal} -e {cmd}";   /* Shift+Enter on a CLI binary in run mode opens it in kitty */
    drun-show-actions:    false;
    cycle:                true;
    hover-select:         true;
    click-to-exit:        true;
    disable-history:      false;
    max-history-size:     50;
    sidebar-mode:         false;   /* set true to show Apps / Run / Windows buttons */

    /* Left/Right switch modes (All/Apps/Run/...); Ctrl+B / Ctrl+F still move the text cursor */
    kb-mode-previous:     "Left,Shift+Left,Control+ISO_Left_Tab";
    kb-mode-next:         "Right,Shift+Right,Control+Tab";
    kb-move-char-back:    "Control+b";
    kb-move-char-forward: "Control+f";

    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
}

@theme "~/.config/rofi/themes/femboy.rasi"