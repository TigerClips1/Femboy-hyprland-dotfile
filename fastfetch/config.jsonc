// ---------------------------------------
// cybr-fastfetch   lucid theme for fastfetch
// Project:    https://github.com/cybrcore/cybr-fastfetch
// Author:     scherrer-txt   |   License:     GPL-3.0
// Source:     ~/.config/fastfetch/config.jsonc
// ---------------------------------------
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	 // Logo drawn with the kitty graphics protocol (works in kitty only)
	 "logo": {
        "source": "~/.config/fastfetch/logos/default.png",
        "type": "kitty-direct"
    },
  // Key color red, no separator between key and value
  "display": {
    "separator": " ",
    "color": "red"
  },
	// Output: a hardware section, then a software section, then a color palette
	"modules": [
		// Hardware
		{
			"type": "custom",
			"key": "{#7} HARDWARE INFORMATION {#}{#35}\uE0B0",
			"keyColor": "#4169e1"
		},
		{
			"type": "board",
			"key": "├─ MTB ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "cpu",
			"key": "├─ CPU ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "gpu",
			"format": "{2}",
			"key": "├─ GPU ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "memory",
			"key": "├─ RAM ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "display",
			"key": "└─ RES ",
			"keyColor": "#ff69b4",
			"compactType": "original"
		},
		"break",
		// Software
		{
			"type": "custom",
			"key": "{#7} SOFTWARE INFORMATION {#}{#35}\uE0B0",
			"keyColor": "#4169e1"
		},
		{
			"type": "os",
			"key": "├─ OS  ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "kernel",
			"key": "├─ KER ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "wm",
			"key": "├─ WM  ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "shell",
			"key": "├─ SH  ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "terminal",
			"key": "├─ TER ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "packages",
			"key": "├─ PKG ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "uptime",
			"key": "└─ UPT ",
			"keyColor": "#ff69b4"
		},
		"break",
		{
			"type": "colors",
			"symbol": "squares",
			"paddingLeft": 8
		}
	]
}