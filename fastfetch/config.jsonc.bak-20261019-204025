{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": "~/.config/fastfetch/logos/logo.png",
  "display": {
    "separator": " ",
    "color": "red"
  },
	"modules": [
		{
			"type": "custom",
			"key": "{#7} HARDWARE INFORMATION {#}{#35}\uE0B0",
			"keyColor": "#4169e1"
		},
		{
			"type": "board",
			"key": "├─ MTB ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "cpu",
			"key": "├─ CPU ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "gpu",
			"format": "{2}",
			"key": "├─ GPU ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "memory",
			"key": "├─ RAM ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "display",
			"key": "└─ RES ",
			"keyColor": "#ff69b4",
			"compactType": "original"
		},
		"break",
		{
			"type": "custom",
			"key": "{#7} SOFTWARE INFORMATION {#}{#35}\uE0B0",
			"keyColor": "#4169e1"
		},
		{
			"type": "os",
			"key": "├─ OS  ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "kernel",
			"key": "├─ KER ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "wm",
			"key": "├─ WM  ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "shell",
			"key": "├─ SH  ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "terminal",
			"key": "├─ TER ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "packages",
			"key": "├─ PKG ",
			"keyColor": "#ff69b4"
		},
		{
			"type": "uptime",
			"key": "└─ UPT ",
			"keyColor": "#ff69b4"
		},
		"break",
		{
			"type": "colors",
			"symbol": "squares",
			"paddingLeft": 8
		}
	]
}